SECRET_KEY=change_this_secret_key_to_something_long_and_random

# SQLite database (created automatically on first run — no server needed)
DATABASE_PATH=studygenie.db

GROQ_API_KEY=your_groq_api_key_here

IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here
IBM_MODEL_ID=ibm/granite-13b-instruct-v2

IBM_ORCHESTRATE_URL=your_orchestrate_url_here
IBM_ORCHESTRATE_API_KEY=your_orchestrate_api_key_here

PORT=5000
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800
